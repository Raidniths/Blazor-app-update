<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <!-- Navigering, länkar till startsidan-->
        <a class="navbar-brand" href="">Blazor Labb Usermangement</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<!-- Navigationsmenyn, döljs eller visas beroende på skärmens storlek-->
<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="new-user">
                <span class="bi bi-person-plus-fill" aria-hidden="true"></span> New User
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="users">
                <span class="bi bi-people-fill" aria-hidden="true"></span> Users
            </NavLink>
        </div>
    </nav>
</div>

@code {
    // Variabel som kontrollerar om navigationsmeny är kollapsad
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
